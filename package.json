{
  "name": "medlem",
  "version": "1.0.0",
  "private": true,
  "description": "medlem",
  "author": "Therese Selberg",
  "keywords": [
    "react",
    "vite",
    "react-router"
  ],
  "scripts": {
    "dev": "vite --port 4000",
    "start": "vite --port 4000",
    "build": "vite build && node scripts/copy-404.mjs",
    "preview": "vite preview",
    "serve": "vite preview --port 4000",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "@zxing/library": "^0.20.0",
    "axios": "^1.6.7",
    "axios-auth-refresh": "^3.3.6",
    "date-fns": "^3.3.1",
    "framer-motion": "^11.0.8",
    "geopattern": "^1.2.3",
    "prop-types": "^15.8.1",
    "qrcode": "^1.5.3",
    "quill": "^2.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-quill": "^2.0.0",
    "react-router-dom": "^7.18.3",
    "react-snowfall": "^2.1.0",
    "sass": "^1.71.1",
    "socket.io-client": "^4.8.3",
    "swr": "^2.2.5",
    "webrtc-adapter": "^8.2.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "gh-pages": "^6.1.1",
    "vite": "^7.3.6"
  }
}
